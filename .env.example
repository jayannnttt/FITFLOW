# AI Fitness Coach Environment Variables Example

# Backend Server Configuration (FastAPI)
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Configurable CORS origins for Backend (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Frontend API & WebSocket Endpoints (Vite React)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_BASE_URL=ws://127.0.0.1:8000
